# Боевой прокси на голом IP, пока нет домена (задача 1.23).
#
# Let's Encrypt сертификат на IP-адрес не выдаёт, поэтому берётся свой,
# самоподписанный, а его открытая часть отправляется Telegram вместе с
# регистрацией вебхука — Telegram это допускает и проверяет цепочку по
# присланному файлу.
#
# Адрес сайта — «:443», а не «https://IP». Разница принципиальная: имя
# сайта Caddy сопоставляет по SNI, а SNI при обращении к IP-адресу не
# передаётся вовсе — так устроен протокол. С именем в заголовке блока
# рукопожатие обрывается, и Telegram получает ошибку соединения.
# Проверено вживую 25.08.2026.
#
# Браузеру такой сертификат не понравится, и это правильно: снаружи здесь
# никто ходить не должен, кроме Telegram.

:443 {
	tls /certs/webhook.pem /certs/webhook.key

	encode zstd gzip

	# Журнал доступа. Тела запроса в нём нет (там текст человека), но
	# строка запроса пишется целиком, вместе с параметрами — поэтому
	# панель из него исключена, см. log_skip ниже.
	log {
		output stdout
		format console
	}

	# Наружу открыты четыре пути, и каждый назван ниже. Проверки живости
	# и всё остальное доступны только изнутри сети контейнеров: чем меньше
	# видно снаружи, тем меньше поводов туда стучаться.
	handle /telegram/webhook {
		reverse_proxy bot:3000
	}

	# Админ-панель (§15 ТЗ, задача 4.5).
	#
	# Второй путь, открытый наружу. Отдаёт её тот же бот:
	# печенье пропуска помечено SameSite=Strict, и панель, живущая на
	# другом адресе, потребовала бы ослабить эту защиту.
	#
	# §15 «панель закрыта от индексации» держится тремя способами:
	# robots.txt в корне, заголовок X-Robots-Tag на каждом ответе панели и
	# мета-тег в самой странице. Каждый из трёх работает не всегда.
	handle /admin* {
		# Панель в журнал доступа Caddy не пишется.
		#
		# Ревизия этапов 1–2: людей панель искала запросом
		# GET /admin/api/people?q=<имя>, а Caddy пишет request.uri целиком,
		# со строкой запроса. Имя человека оказывалось в журнале, до
		# которого не достаёт ни маска логгера бота (Caddy пишет раньше
		# него и в другое место), ни удаление данных по §16. Проверено на
		# caddy:2-alpine v2.11.4 11.09.2026: в строке журнала доступа лежал
		# «q=%D0%A1%D0%B8%D0%B4%D0%BE%D1%80%D0%BE%D0%B2…» — «Сидоров» в
		# URL-кодировке.
		#
		# Доступ к персональным данным панель журналирует сама, как
		# требует §16, — в базу, где след можно и прочитать, и стереть
		# вместе с человеком. Второй, неуправляемый след здесь не нужен.
		#
		# Чего log_skip НЕ делает, проверено там же: журнал ошибок прокси
		# он не глушит. Пока бот лежит (каждая выкладка, каждое падение),
		# на запрос панели Caddy отвечает 502 и пишет строку уровня error
		# с тем же request.uri. Поэтому имени в строке запроса не должно
		# быть вовсе: панель ищет людей POST-ом, имя едет в теле, а тела
		# Caddy не пишет никогда. log_skip — второй слой: он прячет из
		# журнала доступа остальные пути панели, в них наши коды людей.
		#
		# Цена названа: неудачные входы в панель в журнале Caddy теперь
		# тоже не видны — их бот и раньше нигде не записывал.
		log_skip
		reverse_proxy bot:3000
	}

	# И robots.txt: он действует только из корня, поэтому путь отдельный.
	handle /robots.txt {
		reverse_proxy bot:3000
	}

	# Уведомление Робокассы об оплате (§14, задача 4.1).
	#
	# Робокасса шлёт сюда результат каждой оплаты и каждого автосписания.
	# Без этого пути оплата проходит у провайдера, а бот о ней не узнаёт:
	# подписка не включается, человек заплатил впустую. Ревизия этапов 1–2
	# (11.09.2026): путь был написан в боте и покрыт тестами, а наружу
	# открыт не был. Подлинность уведомления проверяет сам бот по подписи
	# с паролем №2; подделка получает 400 и ложится в журнал событий.
	handle /billing/robokassa/result {
		reverse_proxy bot:3000
	}

	handle {
		respond 404
	}
}
