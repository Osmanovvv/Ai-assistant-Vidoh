{
  "name": "vydoh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ВЫДОХ — Telegram-ассистент, разбирающий поток мыслей на структурированные записи",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @vydoh/bot",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/visual && tsc -p .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "infra:reset": "docker compose -f docker-compose.dev.yml down -v",
    "infra:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "test:int": "npm run test:int --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @vydoh/bot",
    "db:migrate": "npm run db:migrate --workspace @vydoh/bot",
    "visual:login": "tsx tests/visual/save-session.ts",
    "visual": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
