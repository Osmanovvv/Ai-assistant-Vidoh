{
  // Конфигурация для редактора, проверки типов и линтера: покрывает
  // и исходники, и конфигурационные файлы, чтобы непроверенных .ts не осталось.
  // Сборка идёт по tsconfig.build.json.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
