# Скопировать в .env и заполнить. Файл .env в репозиторий не попадает (§16 ТЗ).
# Все переменные проверяются при старте: приложение не поднимется
# с неполной или некорректной конфигурацией.

# ─── Приложение ───────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Файл журнала. Пусто — журнал только в стандартный вывод.
# На боевом обязателен: `docker logs` стирается при каждой выкладке.
# LOG_FILE=/app/logs/vydoh.log

# Публичный адрес, на который Telegram шлёт вебхук. Только https:
# по http Telegram вебхук не зарегистрирует.
# В разработке — адрес туннеля (cloudflared, ngrok).
PUBLIC_URL=https://example.invalid

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Токен от @BotFather. Тестовый и боевой боты — разные (§18 ТЗ).
BOT_TOKEN=

# Секрет вебхука: Telegram присылает его в заголовке
# X-Telegram-Bot-Api-Secret-Token, мы обязаны его проверять (§16 ТЗ).
# Допустимы только латиница, цифры, дефис и подчёркивание; не короче 16 символов.
# Сгенерировать: openssl rand -hex 32
BOT_WEBHOOK_SECRET=

# Регистрировать вебхук при старте: true | false | 1 | 0.
# В разработке через туннель — true, при нескольких репликах — false,
# и регистрировать отдельной командой.
BOT_SET_WEBHOOK_ON_BOOT=true

# ─── Приватность ──────────────────────────────────────────────────────────────
# §16 ТЗ: согласие на обработку данных показывается при первом запуске
# одним экраном со ссылкой. Переменная обязательная — заглушку ниже
# нужно заменить до боевого запуска, приложение об этом предупредит.
PRIVACY_POLICY_URL=https://example.invalid/privacy

# ─── Мониторинг ───────────────────────────────────────────────────────────────
# §18 ТЗ: чат, куда приходят оповещения о росте ошибок и падениях.
# Без него мониторинг только пишет в лог.
# MONITORING_CHAT_ID=

# ─── Мягкий лимит расхода ─────────────────────────────────────────────────────
# §10.5 ТЗ: сколько рублей в месяц может стоить один пользователь.
# При превышении тяжёлые стадии переходят на лёгкую модель, человек
# ничего не замечает (§17). Не задан — ограничение выключено.
# Работает только когда в прайс-листе есть цены всех моделей: иначе
# расход неизвестен, и лимит честно скажет об этом в журнал.
# SPEND_LIMIT_RUB=150

# ─── Хранилища ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://vydoh:vydoh@localhost:5434/vydoh
REDIS_URL=redis://localhost:6379

# ─── Расшифровка речи ─────────────────────────────────────────────────────────
# Какой провайдер расшифровывает голосовые: yandex | openai | mock.
# Переключение реализации — одна эта переменная (задача 1.15).
#
# mock — заглушка: возвращает выдуманный текст, ключ не нужен. Годится для
# разработки и тестов, в боевом окружении запрещена: приложение не поднимется.
SPEECH_PROVIDER=mock

# Язык распознавания. Провайдер сам приведёт код к своему виду (ru → ru-RU).
SPEECH_LANGUAGE=ru

# Yandex SpeechKit. Ключ сервисного аккаунта с областью действия
# yc.ai.speechkitStt.execute. Каталог для распознавания не обязателен,
# но понадобится языковым моделям на этапе 2.
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# general — обычная модель, deluxe — точнее и дороже.
YANDEX_SPEECH_MODEL=general

# OpenAI — запасной вариант. Из России сервис не отвечает, поэтому
# OPENAI_BASE_URL задаётся, если запросы идут через посредника.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_SPEECH_MODEL=whisper-1

# ─── Языковая модель ──────────────────────────────────────────────────────────
# Кто разбирает поток мыслей: yandex | mock (задача 2.3).
# mock — заглушка на записанных ответах: ключ не нужен, тесты
# детерминированы и бюджет заказчика не горит. В бою запрещена.
AI_PROVIDER=mock

# Модель. Полная разбирает лучше, лёгкая дешевле — на контрольном наборе
# сравним и выберем (задача 2.20).
YANDEX_LLM_MODEL=yandexgpt/latest

# Ключ и каталог берутся из блока выше: это один сервисный аккаунт
# Yandex Cloud с областями действия и для речи, и для языковых моделей.
# Для языковой модели каталог обязателен — из него собирается modelUri.

# ─── Напоминания ──────────────────────────────────────────────────────────────
# Планировщик утренних, вечерних и срочных напоминаний (§11, задача 3.14).
# on | off. По умолчанию on: напоминания — обещанная часть продукта.
# Выключатель нужен для локальной разработки и для того случая, когда в бою
# рассылку надо остановить быстрее, чем выкатывается правка.
REMINDERS=off

# Предложения запомнить регулярность (задача 3.8в). on | off, по умолчанию off:
# порог схожести не измерен на живых данных.
# RECURRENCE_SUGGESTIONS=off

# ─── Появится на следующих этапах ─────────────────────────────────────────────
# ADMIN_LOGIN=           # этап 4
# ADMIN_PASSWORD_HASH=   # этап 4
