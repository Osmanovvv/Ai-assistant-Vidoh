# Скопировать в .env и заполнить. Файл .env в репозиторий не попадает (§16 ТЗ).
# Все переменные проверяются при старте: приложение не поднимется
# с неполной или некорректной конфигурацией.

# ─── Приложение ───────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Файл журнала. Пусто — журнал только в стандартный вывод.
# На боевом обязателен: `docker logs` стирается при каждой выкладке.
# LOG_FILE=/app/logs/vydoh.log

# Публичный адрес, на который Telegram шлёт вебхук. Только https:
# по http Telegram вебхук не зарегистрирует.
# В разработке — адрес туннеля (cloudflared, ngrok).
PUBLIC_URL=https://example.invalid

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Токен от @BotFather. Тестовый и боевой боты — разные (§18 ТЗ).
BOT_TOKEN=

# Секрет вебхука: Telegram присылает его в заголовке
# X-Telegram-Bot-Api-Secret-Token, мы обязаны его проверять (§16 ТЗ).
# Допустимы только латиница, цифры, дефис и подчёркивание; не короче 16 символов.
# Сгенерировать: openssl rand -hex 32
BOT_WEBHOOK_SECRET=

# Регистрировать вебхук при старте: true | false | 1 | 0.
# В разработке через туннель — true, при нескольких репликах — false,
# и регистрировать отдельной командой.
BOT_SET_WEBHOOK_ON_BOOT=true

# ─── Приватность ──────────────────────────────────────────────────────────────
# §16 ТЗ: согласие на обработку данных показывается при первом запуске
# одним экраном со ссылкой. Переменная обязательная — заглушку ниже
# нужно заменить до боевого запуска, приложение об этом предупредит.
PRIVACY_POLICY_URL=https://example.invalid/privacy
# Публичная оферта (§14): на неё ведёт ссылка с экрана согласия на
# автосписания — Робокасса требует кликабельную ссылку рядом с отметкой
# согласия. Без переменной берётся эта заглушка, и в бою приложение
# предупредит о ней так же, как о политике.
OFFER_URL=https://example.invalid/oferta

# ─── Мониторинг ───────────────────────────────────────────────────────────────
# §18 ТЗ: чат, куда приходят оповещения о росте ошибок и падениях.
# Без него мониторинг только пишет в лог.
# MONITORING_CHAT_ID=

# ─── Мягкий лимит расхода ─────────────────────────────────────────────────────
# §10.5 ТЗ: сколько рублей в месяц может стоить один пользователь.
# При превышении тяжёлые стадии переходят на лёгкую модель, человек
# ничего не замечает (§17). Не задан — ограничение выключено.
# Работает только когда в прайс-листе есть цены всех моделей: иначе
# расход неизвестен, и лимит честно скажет об этом в журнал.
# SPEND_LIMIT_RUB=150

# ─── Потолок расхода по счёту ─────────────────────────────────────────────────
# Задача 3.79. Это НЕ то же, что мягкий лимит выше.
#
# Мягкий лимит считает расход одного человека за месяц и просто
# переводит его выгрузки на лёгкую модель. Потолок считает ВЕСЬ счёт и
# при превышении обращения к модели останавливает: у гранта мягкого
# превышения не бывает — после него бот встаёт целиком.
#
# Что случилось без него: 04.09.2026 за сутки ушло 1977 ₽ при плане 125,
# накопленный расход перешёл несколько тысяч, и 05.09 Yandex ответил 403
# на любой запрос. Узнали из отказа, когда бот уже встал.
#
# Слова человека при остановке не теряются: выгрузка ждёт в очереди и
# разберётся, когда потолок поднимут (как при отказе в доступе, 3.72).
#
# Счёт идёт по той базе, к которой подключён процесс, а ключ Yandex один
# на четыре базы: боевая — лишь 15% расхода проекта. Общую картину по
# всем базам печатает `npx tsx src/scripts/spend.ts`.
#
# Не заданы — потолков нет, поведение прежнее.
# ACCOUNT_SPEND_CEILING_RUB=3000
# ACCOUNT_SPEND_DAILY_RUB=300
# ACCOUNT_SPEND_WARN_SHARE=0.8

# ─── Хранилища ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://vydoh:vydoh@localhost:5434/vydoh
REDIS_URL=redis://localhost:6379

# ─── Расшифровка речи ─────────────────────────────────────────────────────────
# Какой провайдер расшифровывает голосовые: yandex | openai | mock.
# Переключение реализации — одна эта переменная (задача 1.15).
#
# mock — заглушка: возвращает выдуманный текст, ключ не нужен. Годится для
# разработки и тестов, в боевом окружении запрещена: приложение не поднимется.
SPEECH_PROVIDER=mock

# Язык распознавания. Провайдер сам приведёт код к своему виду (ru → ru-RU).
SPEECH_LANGUAGE=ru

# Yandex SpeechKit. Ключ сервисного аккаунта с областью действия
# yc.ai.speechkitStt.execute. Каталог для распознавания не обязателен,
# но понадобится языковым моделям на этапе 2.
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# general — обычная модель, deluxe — точнее и дороже.
YANDEX_SPEECH_MODEL=general

# OpenAI — запасной вариант. Из России сервис не отвечает, поэтому
# OPENAI_BASE_URL задаётся, если запросы идут через посредника.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_SPEECH_MODEL=whisper-1

# ─── Языковая модель ──────────────────────────────────────────────────────────
# Кто разбирает поток мыслей: yandex | mock (задача 2.3).
# mock — заглушка на записанных ответах: ключ не нужен, тесты
# детерминированы и бюджет заказчика не горит. В бою запрещена.
AI_PROVIDER=mock

# Модель. Полная разбирает лучше, лёгкая дешевле — на контрольном наборе
# сравним и выберем (задача 2.20).
YANDEX_LLM_MODEL=yandexgpt/latest

# Ключ и каталог берутся из блока выше: это один сервисный аккаунт
# Yandex Cloud с областями действия и для речи, и для языковых моделей.
# Для языковой модели каталог обязателен — из него собирается modelUri.

# ─── Напоминания ──────────────────────────────────────────────────────────────
# Планировщик утренних, вечерних и срочных напоминаний (§11, задача 3.14).
# on | off. По умолчанию on: напоминания — обещанная часть продукта.
# Выключатель нужен для локальной разработки и для того случая, когда в бою
# рассылку надо остановить быстрее, чем выкатывается правка.
REMINDERS=off

# Предложения запомнить регулярность (задача 3.8в). on | off, по умолчанию off:
# порог схожести не измерен на живых данных.
# RECURRENCE_SUGGESTIONS=off

# ─── Админ-панель (§15 ТЗ, задача 4.5) ────────────────────────────────────────
# Все четыре — или ни одной: при неполной настройке панели нет вовсе, и это
# нарочно. Панель показывает содержимое чужих выгрузок, поэтому забытая строка
# здесь не должна означать «панель без пароля».
#
# Значения получаются одной командой, она же печатает ключ для приложения
# с одноразовыми кодами:
#   npm run admin:secrets --workspace @vydoh/bot
#
# ADMIN_LOGIN=
# ADMIN_PASSWORD_HASH=     # хэш, не пароль: scrypt$...
# ADMIN_TOTP_SECRET=       # секрет одноразовых кодов, base32
# ADMIN_SESSION_SECRET=    # подпись пропусков; смена закрывает все сессии

# ─── Оплата: Робокасса (§14 ТЗ, задача 4.2) ───────────────────────────────────
# Все три — или ни одной: логин без пароля даёт подпись, которую Робокасса
# отвергнет на каждом платеже, а пароль без логина не делает ничего.
# Не заданы — рублёвый рельс выключен, и это нормально до согласования магазина.
#
# Пароли берутся в личном кабинете магазина: «Технические настройки».
# Первым подписывается платёж, вторым проверяется уведомление об оплате.
# Секреты того же разряда, что и токен бота: в журнал они не попадают.
#
# RK_MERCHANT_LOGIN=
# RK_PASSWORD1=
# RK_PASSWORD2=

# Алгоритм подписи — тот, что выбран в кабинете. md5 | sha256 | sha512.
# По умолчанию md5: так стоит у Робокассы из коробки. Расхождение между
# кабинетом и этим значением даёт единственный симптом — «неверная подпись».
# RK_HASH_ALGO=md5

# Тестовый режим: платежи не настоящие. on | off, по умолчанию off.
# ТРЕБУЕТ ТЕСТОВОЙ ПАРЫ ПАРОЛЕЙ: боевой пароль при тестовом режиме даёт
# ту же «ошибку 29», что и кривая формула, и на её поиск уходят часы.
# RK_IS_TEST=off

# Согласована ли услуга рекуррентных платежей. on | off, по умолчанию off.
# Это НЕ техническая настройка: дочерние списания Робокасса включает по
# заявлению магазина, и до согласования они падают кодом 34 — уже после того,
# как человек нажал кнопку оплаты. Пока off, бот честно продаёт разовый период
# и не обещает продления, а суточный проход продления не запускается вовсе.
# RK_RECURRING=off

# ─── Оплата: звёзды Telegram (§14, паритет правил платформы) ──────────────────
# on | off, по умолчанию on.
#
# Включено по умолчанию НЕ для удобства: правила платёжной платформы Telegram
# требуют, чтобы цифровая услуга, продаваемая снаружи, продавалась и за звёзды.
# Санкция названа прямо — бота делают недоступным из магазинных версий Telegram
# либо отключают от платформы. Робокасса при выключенных звёздах — нарушение,
# и старт говорит об этом в журнал.
#
# Выключатель нужен на время, пока цены не назначены, и для разработки.
# STARS=on
