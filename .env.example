# Скопировать в .env и заполнить. Файл .env в репозиторий не попадает (§16 ТЗ).
# Все переменные проверяются при старте: приложение не поднимется
# с неполной или некорректной конфигурацией.

# ─── Приложение ───────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Публичный адрес, на который Telegram шлёт вебхук. Только https:
# по http Telegram вебхук не зарегистрирует.
# В разработке — адрес туннеля (cloudflared, ngrok).
PUBLIC_URL=https://example.invalid

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Токен от @BotFather. Тестовый и боевой боты — разные (§18 ТЗ).
BOT_TOKEN=

# Секрет вебхука: Telegram присылает его в заголовке
# X-Telegram-Bot-Api-Secret-Token, мы обязаны его проверять (§16 ТЗ).
# Допустимы только латиница, цифры, дефис и подчёркивание; не короче 16 символов.
# Сгенерировать: openssl rand -hex 32
BOT_WEBHOOK_SECRET=

# Регистрировать вебхук при старте: true | false | 1 | 0.
# В разработке через туннель — true, при нескольких репликах — false,
# и регистрировать отдельной командой.
BOT_SET_WEBHOOK_ON_BOOT=true

# ─── Хранилища ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://vydoh:vydoh@localhost:5432/vydoh
REDIS_URL=redis://localhost:6379

# ─── Появится на следующих этапах ─────────────────────────────────────────────
# AI_API_KEY=            # задача 1.15, ключ предоставляет заказчик
# AI_BASE_URL=           # адрес релея в Казахстане
# ADMIN_LOGIN=           # этап 4
# ADMIN_PASSWORD_HASH=   # этап 4
