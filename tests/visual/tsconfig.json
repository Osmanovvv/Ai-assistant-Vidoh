{
  // Визуальные тесты входят в проверку типов и в линтер наравне с кодом.
  // Причина та же, по которой стенд качества переехал в src: код вне этих
  // двух рано или поздно гниёт, а проверка перед приёмкой — последнее,
  // что можно позволить сгноить.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // DOM нужен не приложению, а коду, который выполняется в браузере
    // внутри page.evaluate: там настоящие document и Element.
    "lib": ["ES2023", "DOM"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
