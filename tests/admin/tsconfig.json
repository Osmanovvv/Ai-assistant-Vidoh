{
  // Сквозные проверки панели входят в проверку типов и в линтер наравне
  // с кодом — по той же причине, что и визуальные: код вне этих двух
  // рано или поздно гниёт, а проверка перед приёмкой — последнее, что
  // можно позволить сгноить.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // DOM нужен не приложению, а коду, который выполняется в браузере
    // внутри page.evaluate: там настоящие document и Element.
    "lib": ["ES2023", "DOM"],
    // Заглушка прогона набора написана на .mjs: её запускает node, а не
    // сборка, и типы ей не нужны. Но в проект она входить обязана —
    // иначе линтер не может её разобрать и падает разбором, а не
    // правилом. Так `npm run check` был красным с задачи 4.8.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["**/*.ts", "**/*.mjs"],
  "exclude": ["node_modules"]
}
