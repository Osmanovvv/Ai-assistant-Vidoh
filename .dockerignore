# Что не должно попадать в контекст сборки.
#
# Зависимости ставятся внутри образа из package-lock.json: копировать
# node_modules с машины разработчика нельзя — там сборки под другую
# платформу, и образ получился бы неработающим.
node_modules
**/node_modules

.git
.github
dist
**/dist
coverage

# Секреты в образ не едут ни при каких обстоятельствах (§16 ТЗ).
.env
.env.*
ops/caddy/certs
secrets
**/secrets
**/*.env
**/*.env.*
**/.env
**/.env.*
!.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.npmrc
**/.netrc
**/.pgpass

# Материалы заказчика и служебное.
docs
**/docs
*.log
.vscode
.idea

# Локальные сессии, журналы и результаты проверок.
.data
.claude
.cache
.turbo
logs
backups
playwright-report
test-results
tests/eval/runs
**/.data
**/.claude
**/logs
**/backups
**/playwright-report
**/test-results
**/*.log

# Архивы и дампы не нужны для сборки приложения.
**/*.zip
**/*.tar
**/*.tgz
**/*.gz
**/*.bz2
**/*.xz
**/*.zst
**/*.7z
**/*.rar
**/*.dump
**/*.backup
**/*.bak
