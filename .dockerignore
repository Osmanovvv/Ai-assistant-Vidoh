# Что не должно попадать в контекст сборки.
#
# Зависимости ставятся внутри образа из package-lock.json: копировать
# node_modules с машины разработчика нельзя — там сборки под другую
# платформу, и образ получился бы неработающим.
node_modules
**/node_modules

.git
.github
dist
**/dist
coverage

# Секреты в образ не едут ни при каких обстоятельствах (§16 ТЗ).
.env
.env.*
!.env.example
ops/caddy/certs

# Материалы заказчика и служебное.
docs
*.log
.vscode
.idea
